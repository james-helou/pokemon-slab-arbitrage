{
  "name": "pokemon-slab-arb",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:local": "npm run build && node --env-file=.env dist/main.js",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "catalog:sync": "tsx src/catalog/sync-cli.ts",
    "ebay:probe": "tsx src/sources/ebay/probe-cli.ts",
    "probe:local": "node --env-file=.env --import tsx src/sources/ebay/probe-cli.ts",
    "soldcheck:probe": "tsx src/soldcheck/probe-cli.ts",
    "report:weekly": "tsx src/reports/weekly-cli.ts",
    "report:weekly:local": "node --env-file=.env --import tsx src/reports/weekly-cli.ts",
    "matcher:probe": "tsx scripts/matcher-probe.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "discord.js": "^14.27.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
